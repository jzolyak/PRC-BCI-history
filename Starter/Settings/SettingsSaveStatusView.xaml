<UserControl x:Class="Starter.Settings.SettingsSaveStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Starter.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400">

    <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20"
            Width="350"
            Height="Auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect Color="#444"
                              BlurRadius="12"
                              ShadowDepth="4"
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Status"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Message -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="15"
                       FontFamily="Segoe UI"
                       Foreground="#222"
                       Margin="10,0,10,20"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="OK"
                        Width="100"
                        Height="35"
                        Margin="0"
                        FontSize="14"
                        FontFamily="Segoe UI"
                        Background="#0078D7"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Command="{Binding PopupCloseCommand}" />
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
