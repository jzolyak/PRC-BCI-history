<Application x:Class="Starter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Starter"
             xmlns:vm="clr-namespace:ViewModels;assembly=ViewModels"
             xmlns:calibratevm="clr-namespace:ViewModels.Calibration;assembly=ViewModels"
             xmlns:connectivityvm="clr-namespace:ViewModels.Connectivity;assembly=ViewModels" 
             xmlns:settingsvm="clr-namespace:ViewModels.Settings;assembly=ViewModels" 
             xmlns:startupvm="clr-namespace:ViewModels.Startup;assembly=ViewModels"
             xmlns:predictionvm="clr-namespace:ViewModels.Prediction;assembly=ViewModels"
             xmlns:validationvm="clr-namespace:ViewModels.Validation;assembly=ViewModels"
             xmlns:connectivityView="clr-namespace:Starter.Connectivity"
             xmlns:calibrationView="clr-namespace:Starter.Calibration"
             xmlns:predictionView="clr-namespace:Starter.Prediction"
             xmlns:validationView="clr-namespace:Starter.Validation"
             xmlns:settingsView="clr-namespace:Starter.Settings"
             xmlns:startupView="clr-namespace:Starter.Startup"
             xmlns:UIHelpers="clr-namespace:Starter.UIHelpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Grandview"></Setter>
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="25"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
        </Style>

        <Style x:Key="SubHeaderLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="20"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
        </Style>
        

        <Style x:Key="MediumLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="18"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
        </Style>
        <Style x:Key="RedLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="18"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
            <Setter Property="Foreground" Value="Red"></Setter>
        </Style>

        <UIHelpers:ColortoBrushConverter x:Key="colortoBrushConverter"></UIHelpers:ColortoBrushConverter>
        <UIHelpers:SensorStatusConverter x:Key="sensorStatusConverter"></UIHelpers:SensorStatusConverter>
        <UIHelpers:BooltoVisibilityConverter x:Key="booltoVisibilityConverter"></UIHelpers:BooltoVisibilityConverter>
        <SolidColorBrush x:Key="ContentScreenBackGround">#f5f7f8</SolidColorBrush>
        <SolidColorBrush x:Key="ContentScreenBackGroundBrush">#ECEFF1</SolidColorBrush>
       

        <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">
            <!--Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="4" Direction="330" Color="Black" Opacity="0.5" BlurRadius="4"/>
                </Setter.Value>
            </Setter-->
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Style.Resources>
            <Setter Property="BorderThickness" Value="3"></Setter>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"></Setter>
            <Setter Property="Background" Value="White"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="BorderBrush" Value="#B0BEC5"></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B0BEC5"/>
                </Trigger>
            </Style.Triggers>
           
        </Style>
        <Style x:Key="ButtonStyleSmall" TargetType="{x:Type Button}">
            <!--Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="4" Direction="330" Color="Black" Opacity="0.5" BlurRadius="4"/>
                </Setter.Value>
            </Setter-->
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Style.Resources>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
            <Setter Property="Background" Value="White"></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MyBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
        <Style x:Key="CustomErrorControlOnErrorStyle" TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder x:Name="placeholder" />
                            <TextBlock FontSize="20" FontStyle="Italic" Foreground="Red" 
                                       Text="{Binding ElementName=placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type connectivityvm:ConnectivityViewModel}">
            <connectivityView:ConnectivityView DataContext="{Binding}" Height="Auto" Width="Auto"></connectivityView:ConnectivityView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:CalibrationViewModel}">
            <calibrationView:CalibrationView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CalibrationView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:DeleteConfirmationViewModel}">
            <calibrationView:DeleteConfirmationView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:DeleteConfirmationView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:DemoVideoViewModel}">
            <calibrationView:DemoVideoView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:DemoVideoView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:FileNameEntryViewModel}">
            <calibrationView:FileNameEntryView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:FileNameEntryView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:CalibrationBeginQueryViewModel}">
            <calibrationView:CalibrationBeginQueryView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CalibrationBeginQueryView>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type calibratevm:CalibrationRepeatQueryViewModel}">
            <calibrationView:CalibrationRepeatQueryView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CalibrationRepeatQueryView>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type calibratevm:CalibrationStopQueryViewModel}">
            <calibrationView:CalibrationStopQueryView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CalibrationStopQueryView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:CountDownViewModel}">
            <calibrationView:CountDownView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CountDownView>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type calibratevm:CalibrationCompleteViewModel}">
            <calibrationView:CalibrationCompleteView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CalibrationCompleteView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:CalibrationInstructionsViewModel}">
            <calibrationView:CalibrationInstructions DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CalibrationInstructions>
        </DataTemplate>

        <DataTemplate DataType="{x:Type calibratevm:CoeffFileGenerationProgressViewModel}">
            <calibrationView:CoeffFileGenerationProgressView DataContext="{Binding}" Height="Auto" Width="Auto"></calibrationView:CoeffFileGenerationProgressView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type predictionvm:PredictionViewModel}">
            <predictionView:PredictionView DataContext="{Binding}" Height="Auto" Width="Auto"></predictionView:PredictionView>
        </DataTemplate>
      
        <DataTemplate DataType="{x:Type validationvm:ValidationViewModel}">
            <validationView:ValidationView DataContext="{Binding}" Height="Auto" Width="Auto"></validationView:ValidationView>
        </DataTemplate>
      
        <DataTemplate DataType="{x:Type predictionvm:PredictionInstructionsViewModel}">
            <predictionView:PredictionInstructionsView DataContext="{Binding}" Height="Auto" Width="Auto"></predictionView:PredictionInstructionsView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <local:MainMenuView DataContext="{Binding}" Height="Auto" Width="Auto"></local:MainMenuView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type connectivityvm:SensorStatusViewModel}">
            <Canvas Height="50" Width="50" DataContext="{Binding}">
                <Label Content="{Binding SensorText}" Style="{StaticResource MediumLabelStyle}" Foreground="LightCoral" Margin="-5,-25,0,0" VerticalAlignment="Top" VerticalContentAlignment="Top"></Label>
                <Rectangle Height="40" Width="40" Fill="Green" Canvas.Left="0" Canvas.Top="0" Visibility="{Binding SensorStatus,Converter={StaticResource sensorStatusConverter},ConverterParameter='Green',Mode=OneWay}"></Rectangle>
                <Polygon Height="40" Width="40" Fill="Yellow" Points="0,30 15,0 30,30" Canvas.Left="0" Canvas.Top="0" Visibility="{Binding SensorStatus,Converter={StaticResource sensorStatusConverter},ConverterParameter='Yellow',Mode=OneWay}"></Polygon>
                <Ellipse Height="40" Width="40" Fill="Red" Canvas.Left="0" Canvas.Top="0" Visibility="{Binding SensorStatus,Converter={StaticResource sensorStatusConverter},ConverterParameter='Red',Mode=OneWay}"></Ellipse>
                <Label Content="{Binding SensorName}" Style="{StaticResource MediumLabelStyle}"></Label>
            </Canvas>
        </DataTemplate>

        <DataTemplate DataType="{x:Type startupvm:StartupViewModel}">
            <startupView:StartupScreen DataContext="{Binding}" Height="Auto" Width="Auto"></startupView:StartupScreen>
        </DataTemplate>
        <DataTemplate DataType="{x:Type startupvm:FirstScreenViewModel}">
            <startupView:FirstScreen DataContext="{Binding}" Height="Auto" Width="Auto"></startupView:FirstScreen>
        </DataTemplate>
        <DataTemplate DataType="{x:Type startupvm:HeadsetStartupStatusViewModel}">
            <startupView:HeadsetStartupStatusView DataContext="{Binding}" Height="Auto" Width="Auto"></startupView:HeadsetStartupStatusView>
        </DataTemplate>

        <Style x:Key="TextBoxInError" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip"
              Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                              Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <DataTemplate DataType="{x:Type settingsvm:SettingsDetailViewModel}">
            <settingsView:SettingsDetailView></settingsView:SettingsDetailView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type settingsvm:SettingsCategoryViewModel}">
            <settingsView:SettingsCategoryView></settingsView:SettingsCategoryView>
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsvm:SettingsSaveStatusViewModel}">
            <settingsView:SettingsSaveStatusView Height="Auto" Width="Auto"></settingsView:SettingsSaveStatusView>
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsvm:SettingsViewModel}">
            <settingsView:SettingsView/>
        </DataTemplate>

        <ControlTemplate x:Key="ValidationTemplate">
            <DockPanel>
                <TextBlock Foreground="Red" FontSize="20">!</TextBlock>
                <AdornedElementPlaceholder/>
            </DockPanel>
            
        </ControlTemplate>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="22"/>
        </Style>


        <!-- FocusVisual -->

        <Style x:Key="ButtonFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border>
                            <Rectangle Margin="2"
                     StrokeThickness="1"
                     Stroke="#60000000"
                     StrokeDashArray="1 2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Control colors.-->
        <Color x:Key="WindowColor">#FFE8EDF9</Color>
        <Color x:Key="ContentAreaColorLight">#FFC5CBF9</Color>
        <Color x:Key="ContentAreaColorDark">#FF7381F9</Color>

        <Color x:Key="DisabledControlLightColor">#FFE8EDF9</Color>
        <Color x:Key="DisabledControlDarkColor">#FFC5CBF9</Color>
        <Color x:Key="DisabledForegroundColor">#FF888888</Color>

        <Color x:Key="SelectedBackgroundColor">#FFC5CBF9</Color>
        <Color x:Key="SelectedUnfocusedColor">#FFDDDDDD</Color>

        <Color x:Key="ControlLightColor">White</Color>
        <Color x:Key="ControlMediumColor">#FF7381F9</Color>
        <Color x:Key="ControlDarkColor">#FF211AA9</Color>

        <Color x:Key="ControlMouseOverColor">#FF3843C4</Color>
        <Color x:Key="ControlPressedColor">#FF211AA9</Color>


        <Color x:Key="GlyphColor">#FF444444</Color>
        <Color x:Key="GlyphMouseOver">sc#1, 0.004391443, 0.002428215, 0.242281124</Color>

        <!--Border colors-->
        <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
        <Color x:Key="BorderMediumColor">#FF888888</Color>
        <Color x:Key="BorderDarkColor">#FF444444</Color>

        <Color x:Key="PressedBorderLightColor">#FF888888</Color>
        <Color x:Key="PressedBorderDarkColor">#FF444444</Color>

        <Color x:Key="DisabledBorderLightColor">#FFAAAAAA</Color>
        <Color x:Key="DisabledBorderDarkColor">#FF888888</Color>

        <Color x:Key="DefaultBorderBrushDarkColor">Black</Color>

        <!--Control-specific resources.-->
        <Color x:Key="HeaderTopColor">#FFC5CBF9</Color>
        <Color x:Key="DatagridCurrentCellBorderColor">Black</Color>
        <Color x:Key="SliderTrackDarkColor">#FFC5CBF9</Color>

        <Color x:Key="NavButtonFrameColor">#FF3843C4</Color>

        <LinearGradientBrush x:Key="MenuPopupBrush"
                     EndPoint="0.5,1"
                     StartPoint="0.5,0">
            <GradientStop Color="{DynamicResource ControlLightColor}"
                Offset="0" />
            <GradientStop Color="{DynamicResource ControlMediumColor}"
                Offset="0.5" />
            <GradientStop Color="{DynamicResource ControlLightColor}"
                Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill"
                     StartPoint="0,0"
                     EndPoint="1,0">
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#000000FF"
                    Offset="0" />
                    <GradientStop Color="#600000FF"
                    Offset="0.4" />
                    <GradientStop Color="#600000FF"
                    Offset="0.6" />
                    <GradientStop Color="#000000FF"
                    Offset="1" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <!-- Button -->
         <!-- Button -->
        <Style x:Key="buttonstyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="SnapsToDevicePixels"
          Value="true" />
            <Setter Property="OverridesDefaultStyle"
          Value="true" />
            <Setter Property="FocusVisualStyle"
          Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="MinHeight"
          Value="23" />
            <Setter Property="MinWidth"
          Value="75" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border TextBlock.Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                x:Name="Border"
                CornerRadius="2"
                BorderThickness="{TemplateBinding BorderThickness}">
                         
                           
                            <ContentPresenter Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                        </Border>
                       </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="buttonstyle1" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="SnapsToDevicePixels"
          Value="true" />
            <Setter Property="OverridesDefaultStyle"
          Value="true" />
            <Setter Property="FocusVisualStyle"
          Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="MinHeight"
          Value="23" />
            <Setter Property="MinWidth"
          Value="75" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border TextBlock.Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" MinHeight="100"
                x:Name="Border"
                CornerRadius="2"
                BorderThickness="{TemplateBinding BorderThickness}">


                            <ContentPresenter Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
