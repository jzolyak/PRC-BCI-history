<?xml version="1.0" encoding="UTF-8"?>
<UserControl 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             x:Class="Starter.Calibration.CalibrationBeginQueryView" Background="White" Height="300" Width="600">
  
        <StackPanel>
            <Label x:Name="queryLabel" Content="{Binding Text}" HorizontalAlignment="Center" Margin="0,80,0,40" FontSize="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="startButton" Height="40" Width="140" Margin="0,40,40,40"  Content="Start" FontSize="25" Style="{StaticResource ButtonStyle}" Command="{Binding StartCommand}" />
                <Button x:Name="cancelButton" Height="40" Width="140" Content="Cancel"  FontSize="25" Style="{StaticResource ButtonStyle}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>

</UserControl>