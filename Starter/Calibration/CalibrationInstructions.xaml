<UserControl x:Class="Starter.Calibration.CalibrationInstructions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Starter.Calibration"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" Height="400" Width="600">

    <Grid x:Name="CalibrateDock">
        <StackPanel>
            <Label Content="Calibration is about to start ..." HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="22"/>
            <Label Content="In your head, count the number of times your target flashes" Margin="20,20,0,0" FontSize="18"/>
            <Label Content="Your target is highlighted in red" Margin="20,10,0,0" FontSize="18"/>
            <Label Content="Please remember to:" Margin="20,10,0,0" Padding="0" FontSize="18"/>
            <Label Content="    (1) Stay awake" Margin="20,0,0,0" Padding="0" FontSize="18"/>
            <Label Content="    (2) Ignore any noise" Margin="20,0,0,0" Padding="0" FontSize="18"/>
            <Label Content="    (3) Watch the monitor at all times" Margin="20,0,0,0" Padding="0" FontSize="18"/>
            <Label Content="    (4) Keep your head still at all times" Margin="20,0,0,0" Padding="0" FontSize="18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="startButton" Height="40" Width="100" Margin="0,40,40,40"
                    Content="Start" FontSize="22"  Style="{StaticResource ButtonStyle}" Command="{Binding StartCalibrationCommand}" />
                <Button x:Name="cancelButton" Height="40" Width="100" 
                    Content="Cancel"  FontSize="22" Style="{StaticResource ButtonStyle}" Command="{Binding PopupCloseCommand}"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Height="50" Width="50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="350,130,0,0"
                   Fill="Red"/>
        <Rectangle Height="40" Width="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="355,135,0,0"
                   Fill="White"/>

    </Grid>

</UserControl>
