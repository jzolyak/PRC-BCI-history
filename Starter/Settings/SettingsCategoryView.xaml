<UserControl x:Class="Starter.Settings.SettingsCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Starter.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="#f5f5f5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- Settings List Section -->
        <ItemsControl Name="settings" ItemsSource="{Binding SettingsList}" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto" 
                      VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="500" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Header Label with Styled Font -->
                        <Label Grid.Column="0" Content="{Binding Header}" 
                               Style="{StaticResource MediumLabelStyle}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontWeight="Bold" FontSize="18" Foreground="#333" />

                        <!-- Content TextBox with rounded corners using Border -->
                        <Border Grid.Column="1" Background="#ffffff" BorderBrush="#cccccc" 
                                BorderThickness="1" CornerRadius="8" Margin="5,0">
                            <TextBox Text="{Binding Content}" 
                                     Style="{StaticResource TextBoxInError}" 
                                     Height="50" 
                                     VerticalContentAlignment="Center" 
                                     Padding="12,8" FontSize="18" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Button Section -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="150" Margin="8" Style="{StaticResource ButtonStyle}" FontSize="20" Content="Save" Command="{Binding SaveCmd}"></Button>
            <Button HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="150" Margin="8" Style="{StaticResource ButtonStyle}" FontSize="20" Content="Return" Command="{Binding ReturnCmd}"></Button>
        </StackPanel>

        <Border Background="#80000000"
        Visibility="{Binding ShowPopup, Converter={StaticResource BoolToVis}}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Panel.ZIndex="99">
            <ContentControl Content="{Binding PopupContentViewModel}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    Width="400"
                    Height="200" />
        </Border>
    </Grid>
</UserControl>
