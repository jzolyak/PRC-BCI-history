<?xml version="1.0" encoding="UTF-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Starter.Calibration"
             x:Class="Starter.Calibration.CountDownView" Background="White" Height="150" Width="300">
        <Grid>
            <Label x:Name="countDownLabel" Content="Calibration Set 1 will begin in ..." FontSize="20" Margin="20,20,0,0" />
            <TextBox x:Name="countDownValue" Text="{Binding Text}" FontSize="30" BorderThickness="0"  Height="60" Width="60" Margin="20,40,0,0"  />
        </Grid>
</UserControl>