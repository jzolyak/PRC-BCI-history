<Application x:Class="Starter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Starter"
             xmlns:vm="clr-namespace:ViewModels;assembly=ViewModels"
             xmlns:calibratevm="clr-namespace:ViewModels.Calibration;assembly=ViewModels"
             xmlns:connectivityvm="clr-namespace:ViewModels.Connectivity;assembly=ViewModels"             
             xmlns:connectivityView="clr-namespace:Starter.Connectivity"
             xmlns:UIHelpers="clr-namespace:Starter.UIHelpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Grandview"></Setter>
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Calibri"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="25"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
        </Style>

        <Style x:Key="MediumLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Calibri"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="18"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
        </Style>
        <Style x:Key="RedLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Calibri"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="18"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
            <Setter Property="Foreground" Value="Red"></Setter>
        </Style>

        <UIHelpers:ColortoBrushConverter x:Key="colortoBrushConverter"></UIHelpers:ColortoBrushConverter>
        <UIHelpers:SensorStatusConverter x:Key="sensorStatusConverter"></UIHelpers:SensorStatusConverter>
        <SolidColorBrush x:Key="ContentScreenBackGround">#f5f7f8</SolidColorBrush>
        <SolidColorBrush x:Key="ContentScreenBackGroundBrush">#EFF1F3</SolidColorBrush>

        <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">
            <!--Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="4" Direction="330" Color="Black" Opacity="0.5" BlurRadius="4"/>
                </Setter.Value>
            </Setter-->
            <Setter Property="BorderThickness" Value="2"></Setter>
            <Setter Property="FontFamily" Value="Calibri"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontStretch" Value="Condensed"></Setter>
            <Setter Property="Background" Value="White"></Setter>
        </Style>

        <Style x:Key="MyBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>

        <DataTemplate DataType="{x:Type connectivityvm:ConnectivityViewModel}">
            <connectivityView:ConnectivityView DataContext="{Binding}" Height="Auto" Width="Auto"></connectivityView:ConnectivityView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <local:MainMenuView DataContext="{Binding}" Height="Auto" Width="Auto"></local:MainMenuView>
        </DataTemplate>

        <DataTemplate DataType="{x:Type connectivityvm:SensorStatusViewModel}">
            <Canvas Height="50" Width="50" DataContext="{Binding}">
                <Label Content="{Binding SensorText}" Style="{StaticResource MediumLabelStyle}" Foreground="LightCoral" Margin="-5,-25,0,0" VerticalAlignment="Top" VerticalContentAlignment="Top"></Label>
                <Rectangle Height="40" Width="40" Fill="Green" Canvas.Left="0" Canvas.Top="0" Visibility="{Binding SensorStatus,Converter={StaticResource sensorStatusConverter},ConverterParameter='Green',Mode=OneWay}"></Rectangle>
                <Polygon Height="40" Width="40" Fill="Yellow" Points="0,30 15,0 30,30" Canvas.Left="0" Canvas.Top="0" Visibility="{Binding SensorStatus,Converter={StaticResource sensorStatusConverter},ConverterParameter='Yellow',Mode=OneWay}"></Polygon>
                <Ellipse Height="40" Width="40" Fill="Red" Canvas.Left="0" Canvas.Top="0" Visibility="{Binding SensorStatus,Converter={StaticResource sensorStatusConverter},ConverterParameter='Red',Mode=OneWay}"></Ellipse>
                <Label Content="{Binding SensorName}" Style="{StaticResource MediumLabelStyle}"></Label>
            </Canvas>
        </DataTemplate>


    </Application.Resources>
</Application>
